// Nextflow configuration for miND pipeline
// miRNA NGS data analysis pipeline

// Pipeline parameters
params {
    // Input/Output
    sampleSheet = null
    outputSubfolder = null
    outdir = 'output'
    
    // Resource allocation
    threads_high = 6
    threads_medium = 4
    threads_low = 2
    
    // Reference data paths
    repoPath = "repository/data"
    
    // miRBase and RNAcentral versions
    miRBaseVersion = "22.1"
    rnacentralVersion = "19.0"
    
    // Species data - default to Homo sapiens
    speciesName = "Homo sapiens"
    speciesTxid = "9606"
    speciesCode = "hsa"
    genomeID = "GRCh38"
    genomeVersion = "p13"
    
    // Analysis parameters
    minReadCount = 1
    readMinLength = "17"
    qualityCutoff = "30"
    alpha = "0.05"
    
    // Spike-in parameters
    includeSpikeIns = 0
    spikeInVersion = null
    includeSequence = 0
    
    // Adapter trimming
    adapter = "-a IlluminaUniversal=AGATCGGAAGAG"
    adapterName = "Illumina Universal Adapter"
    
    // Differential expression
    deAnalysis = 0
    
    // Project metadata
    projectID = 'none'
    projectComment = ''
    
    // Conda settings
    condaPath = "envs/tmp"
}

// Process configuration
process {
    // Error handling
    errorStrategy = 'retry'
    maxRetries = 1
    
    // Conda configuration
    conda = "${projectDir}/envs"
    
    // Resource labels
    withLabel: low_cpu {
        cpus = params.threads_low
    }
    
    withLabel: medium_cpu {
        cpus = params.threads_medium
    }
    
    withLabel: high_cpu {
        cpus = params.threads_high
    }
    
    // Process-specific conda environments
    withName: 'FASTQC.*' {
        conda = "${projectDir}/envs/fastqc.yml"
    }
    
    withName: 'CUTADAPT' {
        conda = "${projectDir}/envs/cutadapt.yml"
    }
    
    withName: 'MULTIQC' {
        conda = "${projectDir}/envs/multiqc.yml"
    }
    
    withName: 'BAM2FASTQ' {
        conda = "${projectDir}/envs/samtools.yml"
    }
    
    withName: 'SEQCLUSTER_COLLAPSE' {
        conda = "${projectDir}/envs/seqcluster.yml"
    }
    
    withName: 'MIRDEEP2_PREP|MIRDEEP2_QUANTIFIER' {
        conda = "${projectDir}/envs/mirdeep2.yml"
    }
    
    withName: 'BOWTIE_.*' {
        conda = "${projectDir}/envs/bowtie1.yml"
    }
    
    withName: 'BBDUK_.*' {
        conda = "${projectDir}/envs/bbmap.yml"
    }
    
    withName: 'RSCRIPT_.*|COMBINE_.*|QUANTIFY_.*|DE_ANALYSIS|MAKE_HTML_REPORT' {
        conda = "${projectDir}/envs/ranalysis.yml"
    }
}

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
    }
    
    conda {
        conda.enabled = true
        conda.useMamba = true
        conda.createTimeout = '1 h'
    }
    
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

// Workflow execution settings
executor {
    $local {
        cpus = 48
        memory = '128 GB'
    }
}

// Reporting
report {
    enabled = true
    file = "${params.outdir}/pipeline_report.html"
}

timeline {
    enabled = true
    file = "${params.outdir}/timeline.html"
}

trace {
    enabled = true
    file = "${params.outdir}/trace.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/dag.svg"
}

// Manifest
manifest {
    name = 'miND'
    author = 'Andreas B. Diendorfer'
    description = 'miRNA NGS data pipeline - Nextflow version'
    mainScript = 'main.nf'
    version = '2.0'
    nextflowVersion = '>=21.04.0'
}
