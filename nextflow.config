// Nextflow configuration for miND pipeline
// miRNA NGS data analysis pipeline

// Enable DSL2
nextflow.enable.dsl = 2

// Pipeline parameters
params {
    // Input/Output
    input = null  // Primary input parameter (nf-core standard)
    sampleSheet = null  // Backward compatibility alias for --input
    outputSubfolder = null
    outdir = 'output'
    tracedir = "${params.outdir}/pipeline_info"
    publish_dir_mode = 'copy'
    
    // Resource allocation
    threads_high = 6
    threads_medium = 4
    threads_low = 2
    
    // Reference data paths
    repoPath = "repository/data"
    
    // miRBase and RNAcentral versions
    miRBaseVersion = "22.1"
    rnacentralVersion = "19.0"
    
    // Species data - default to Homo sapiens
    speciesName = "Homo sapiens"
    speciesTxid = "9606"
    speciesCode = "hsa"
    genomeID = "GRCh38"
    genomeVersion = "p13"
    
    // Analysis parameters
    minReadCount = 1
    readMinLength = "17"
    qualityCutoff = "30"
    alpha = "0.05"
    
    // Spike-in parameters
    includeSpikeIns = 0
    spikeInVersion = null
    includeSequence = 0
    
    // Adapter trimming
    adapter = "-a IlluminaUniversal=AGATCGGAAGAG"
    adapterName = "Illumina Universal Adapter"
    
    // Differential expression
    deAnalysis = 0
    
    // Project metadata
    projectID = 'none'
    projectComment = ''
    
    // Boilerplate options - nf-core compliance
    help = false
    version = false
    validate_params = true
    show_hidden_params = false
    schema_ignore_params = 'genomes'
    
    // Max resource options
    max_memory = '128.GB'
    max_cpus = 48
    max_time = '240.h'
}

// Process configuration
process {
    // Default settings
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('.command.sh') ? null : filename }
    ]
    
    // Error handling
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries = 1
    maxErrors = '-1'
    
    // Conda configuration
    conda = "${projectDir}/envs"
    
    // Resource labels - nf-core compliance
    withLabel: 'process_single' {
        cpus = 1
        memory = { check_max( 6.GB * task.attempt, 'memory' ) }
        time = { check_max( 4.h * task.attempt, 'time' ) }
    }
    withLabel: low_cpu {
        cpus = { check_max( params.threads_low * task.attempt, 'cpus' ) }
        memory = { check_max( 6.GB * task.attempt, 'memory' ) }
        time = { check_max( 4.h * task.attempt, 'time' ) }
    }
    
    withLabel: medium_cpu {
        cpus = { check_max( params.threads_medium * task.attempt, 'cpus' ) }
        memory = { check_max( 12.GB * task.attempt, 'memory' ) }
        time = { check_max( 8.h * task.attempt, 'time' ) }
    }
    
    withLabel: high_cpu {
        cpus = { check_max( params.threads_high * task.attempt, 'cpus' ) }
        memory = { check_max( 24.GB * task.attempt, 'memory' ) }
        time = { check_max( 16.h * task.attempt, 'time' ) }
    }
    
    withLabel: 'error_ignore' {
        errorStrategy = 'ignore'
    }
    withLabel: 'error_retry' {
        errorStrategy = 'retry'
        maxRetries = 2
    }
    
    // Process-specific conda environments
    withName: 'FASTQC.*' {
        conda = "${projectDir}/envs/fastqc.yml"
    }
    
    withName: 'CUTADAPT' {
        conda = "${projectDir}/envs/cutadapt.yml"
    }
    
    withName: 'MULTIQC' {
        conda = "${projectDir}/envs/multiqc.yml"
    }
    
    withName: 'BAM2FASTQ' {
        conda = "${projectDir}/envs/samtools.yml"
    }
    
    withName: 'SEQCLUSTER_COLLAPSE' {
        conda = "${projectDir}/envs/seqcluster.yml"
    }
    
    withName: 'MIRDEEP2_PREP|MIRDEEP2_QUANTIFIER' {
        conda = "${projectDir}/envs/mirdeep2.yml"
    }
    
    withName: 'BOWTIE_.*' {
        conda = "${projectDir}/envs/bowtie1.yml"
    }
    
    withName: 'BBDUK_.*' {
        conda = "${projectDir}/envs/bbmap.yml"
    }
    
    withName: 'RSCRIPT_.*|COMBINE_.*|QUANTIFY_.*|DE_ANALYSIS|MAKE_HTML_REPORT' {
        conda = "${projectDir}/envs/ranalysis.yml"
    }
}

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
    }
    
    conda {
        conda.enabled = true
        conda.useMamba = true
        conda.createTimeout = '1 h'
    }
    
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

// Workflow execution settings
executor {
    $local {
        cpus = 48
        memory = '128 GB'
    }
}

// Reporting - nf-core compliance
def trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
report {
    enabled = true
    file = "${params.tracedir}/execution_report_${trace_timestamp}.html"
}

timeline {
    enabled = true
    file = "${params.tracedir}/execution_timeline_${trace_timestamp}.html"
}

trace {
    enabled = true
    file = "${params.tracedir}/execution_trace_${trace_timestamp}.txt"
}

dag {
    enabled = true
    file = "${params.tracedir}/pipeline_dag_${trace_timestamp}.svg"
}

// Function to check maximum resource limits
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            log.warn "Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            log.warn "Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            log.warn "Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}

// Manifest - nf-core compliance
manifest {
    name = 'miND'
    author = 'Andreas B. Diendorfer'
    homePage = 'https://github.com/AHinsu/miND'
    description = 'miRNA NGS data analysis pipeline'
    mainScript = 'main.nf'
    version = '2.0.0'
    nextflowVersion = '>=21.04.0'
    doi = ''
}
